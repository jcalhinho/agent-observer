{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Observer",
  "version": "0.17.0",
  "identifier": "dev.repowatcher.agentobserver",
  "build": {
    "beforeDevCommand": "npm run dev --workspace @repo-watcher/agent-observer-desktop",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build --workspace @repo-watcher/agent-observer-desktop",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Agent Observer",
        "width": 1440,
        "height": 920,
        "minWidth": 1120,
        "minHeight": 720,
        "center": true,
        "backgroundColor": "#101318"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "category": "DeveloperTool",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/installer-hooks.nsh"
      },
      "wix": {
        "upgradeCode": "d8a27f53-b00a-59b4-b6e4-2dcfa0ec1e65"
      }
    },
    "linux": {
      "deb": {
        "conflicts": ["repo-watcher-agent-observer"],
        "replaces": ["repo-watcher-agent-observer"]
      }
    },
    "shortDescription": "Local dashboard of what your AI coding agents are doing",
    "longDescription": "One private screen for Claude Code, Codex, Copilot, Cursor, Continue and other coding agents: who needs you, who is looping, tokens, cache, cost and context."
  }
}
